# Copy to .env.local and fill in. Never commit .env.local.

# ── Supabase (Project Settings → API) ─────────────────────────────
# Safe for the browser: these are protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# ── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI (optional) ─────────────────────────────────────────────────
# Leave AI_PROVIDER empty to run without AI. The rest of the platform works fully.
# Supported values: anthropic | openai | gemini
AI_PROVIDER=
AI_API_KEY=
# Optional model override; each provider adapter has a sensible default.
AI_MODEL=
# Hard per-request timeout in milliseconds.
AI_TIMEOUT_MS=20000

# ── Pro payments ──────────────────────────────────────────────────
# Live payments are NOT built in. Never set this in production.
# PAYMENTS_TEST_MODE=1 shows a simulator on /pro for test environments only, and it
# also needs, in a TEST database only: insert into public.private_settings values ('payments_test_mode', 'on');
PAYMENTS_TEST_MODE=
